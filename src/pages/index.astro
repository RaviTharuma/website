---
import Base from "../layouts/Base.astro";
import { getHomepage, getSite } from "../lib/content";

const page = getHomepage();
const site = getSite();
---

<Base title={page.title} description={page.description} current="/" footer="home">
  <section class="hero">
    <div class="art" aria-hidden="true">
      <div class="card metric">
        <p class="metric-value">{page.metric.value}</p>
        <p class="metric-label">{page.metric.label}</p>
        <p class="metric-caption">{page.metric.caption}</p>
      </div>
      <div class="card chart">
        <p class="chart-kicker">{page.chart.kicker}</p>
        <p class="chart-title">{page.chart.title}</p>
        {
          page.chart.bars.map((bar) => (
            <div class="bar">
              <span>{bar.label}</span>
              <i class={bar.tone}></i>
            </div>
          ))
        }
      </div>
    </div>
    <div class="copy">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="headline">{page.headline}</h1>
      <p class="support">{page.support}</p>
      <ul class="points">
        {
          page.points.map((point) => (
            <li>
              <p>
                <strong>{point.lead}</strong>
                <span> {point.rest}</span>
              </p>
            </li>
          ))
        }
      </ul>
      <div class="actions">
        <a class="button" href={site.bookHref}>{site.bookLabel}</a>
        <p class="reply">{page.reply}</p>
      </div>
    </div>
  </section>
  <ul class="proof">
    {page.proof.map((item) => <li>{item}</li>)}
  </ul>
  <hr class="rule" />
  <section class="changes">
    <h2>{page.changesTitle}</h2>
    <div class="change-grid">
      {
        page.changes.map((change) => (
          <article class="change">
            <h2>{change.title}</h2>
            <p>{change.body}</p>
          </article>
        ))
      }
    </div>
  </section>
  <hr class="rule" />
</Base>
